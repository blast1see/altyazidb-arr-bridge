{
  "manifest_version": 3,
  "name": "AltyaziDB Arr Bridge",
  "version": "0.1.3",
  "description": "Adds Radarr, Sonarr, Prowlarr, and Jackett lookup buttons to AltyaziDB subtitle pages.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "AltyaziDB Arr Bridge",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://altyazidb.com/*",
    "http://*.altyazidb.com/*",
    "https://altyazidb.com/*",
    "https://*.altyazidb.com/*",
    "http://localhost:7878/*",
    "http://127.0.0.1:7878/*",
    "http://localhost:8989/*",
    "http://127.0.0.1:8989/*",
    "http://localhost:9696/*",
    "http://127.0.0.1:9696/*",
    "http://localhost:9117/*",
    "http://127.0.0.1:9117/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://altyazidb.com/*",
        "http://*.altyazidb.com/*",
        "https://altyazidb.com/*",
        "https://*.altyazidb.com/*"
      ],
      "exclude_matches": [
        "*://altyazidb.com/forum/*",
        "*://*.altyazidb.com/forum/*",
        "*://altyazidb.com/user/*",
        "*://*.altyazidb.com/user/*",
        "*://altyazidb.com/search/*",
        "*://*.altyazidb.com/search/*",
        "*://altyazidb.com/admin/*",
        "*://*.altyazidb.com/admin/*"
      ],
      "js": [
        "src/config.js",
        "src/content.js"
      ],
      "css": [
        "styles/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/radarr-reference.png",
        "assets/sonarr-reference.png",
        "assets/prowlarr-reference.png",
        "assets/jackett-reference.png"
      ],
      "matches": [
        "http://altyazidb.com/*",
        "http://*.altyazidb.com/*",
        "https://altyazidb.com/*",
        "https://*.altyazidb.com/*"
      ]
    }
  ]
}
