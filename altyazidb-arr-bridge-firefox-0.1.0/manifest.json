{
  "manifest_version": 2,
  "name": "AltyaziDB Arr Bridge",
  "version": "0.1.0",
  "description": "Adds Radarr and Sonarr lookup buttons to AltyaziDB subtitle pages.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "browser_action": {
    "default_title": "AltyaziDB Arr Bridge",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "http://altyazidb.com/*",
    "http://*.altyazidb.com/*",
    "https://altyazidb.com/*",
    "https://*.altyazidb.com/*",
    "http://localhost:7878/*",
    "http://127.0.0.1:7878/*",
    "http://localhost:8989/*",
    "http://127.0.0.1:8989/*",
    "http://localhost:9696/*",
    "http://127.0.0.1:9696/*"
  ],
  "background": {
    "scripts": [
      "src/config.js",
      "src/background.js"
    ],
    "persistent": false
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "http://altyazidb.com/*",
        "http://*.altyazidb.com/*",
        "https://altyazidb.com/*",
        "https://*.altyazidb.com/*"
      ],
      "js": [
        "src/config.js",
        "src/content.js"
      ],
      "css": [
        "styles/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "assets/radarr-reference.png",
    "assets/sonarr-reference.png",
    "assets/prowlarr-reference.png"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "altyazidb-arr-bridge@example.local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
